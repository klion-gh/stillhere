# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://stillhere:stillhere@localhost:5432/stillhere?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
PORT="3000"
HOST="0.0.0.0"
CORS_ORIGIN="*"
# Optional locally; required in production for calls to work behind NAT (see docker/.env.example)
TURN_SECRET=""
TURN_URL=""
TURN_TTL_SECONDS="3600"
NODE_TOKEN_SECRET="change-me-node-token-secret"
NODE_TOKEN_TTL="365d"
# Only used once on first boot to set the node password (see src/modules/node/bootstrap.ts).
NODE_SETUP_PASSWORD="change-me-node-password"
