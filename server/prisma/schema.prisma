generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-row table: the shared secret that gates this node. Bootstrapped
// once from NODE_SETUP_PASSWORD on first server start (see src/index.ts).
model NodeConfig {
  id           String   @id @default(uuid())
  passwordHash String
  createdAt    DateTime @default(now())
}

// Small key/value store for node-level state that has to survive a restart.
// Currently only whether diagnostics are recording.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Diagnostic trail, written only while diagnostics are switched on. Off by
// default and pruned to a few days, because it records who did what and when
// — useful for chasing a call that wouldn't connect, not something to keep
// running on a private messenger.
model DiagnosticEvent {
  id       String   @id @default(uuid())
  at       DateTime @default(now())
  // Deliberately not a foreign key: the trail should survive the user row
  // being deleted, and it must never block a deletion.
  userId   String?
  username String?
  source   String
  kind     String
  detail   String?
  data     Json?

  @@index([at])
  @@index([userId, at])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Avatars are small (re-encoded and size-capped on upload), so keeping the
  // bytes in the row avoids a shared volume and keeps a node one container
  // plus one database.
  avatar      Bytes?
  avatarMime  String?
  avatarUpdatedAt DateTime?

  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  messages         Message[]
  devices          DeviceToken[]
}

// Push targets for a user's devices. One row per device; a user signed in
// on a phone and a desktop has one of each, and every device that can be
// woken gets the push.
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User          @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}
