node_modules/
dist/
.env
docker/.env
docker/certs/*
!docker/certs/.gitkeep
# Generated by install.sh with the node's actual TLS setup (self-signed for an
# IP, a real certificate for a domain). It used to be tracked, which meant a
# `git pull` on a live node replaced the working config with the template and
# Caddy refused to start. See docker/Caddyfile.example.
docker/Caddyfile
*.log

# Claude Code session state (not project code)
.claude/

# Flutter / Dart
client/.dart_tool/
client/.flutter-plugin-dependencies
client/build/
client/android/.gradle/
client/windows/flutter/ephemeral/
client/**/ephemeral/

# Firebase service account key — grants the right to push to every user of
# the app. Lives outside the repo; the server reads it from a mounted file.
**/firebase-service-account.json
**/*-firebase-adminsdk-*.json
docker/secrets/*
!docker/secrets/.gitkeep
# Firebase client config is now served by the node at runtime, so no build
# carries a hardcoded project. A stray copy here would silently re-bake one.
client/android/app/google-services.json
