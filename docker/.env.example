# Copy to docker/.env and fill in real values. Never commit .env.
#
# This file is for MANUAL setup. If you used install.sh, it already
# generated docker/.env for you — you shouldn't need to touch this.

# Either a domain that already points (A record) at this VPS's IP, or the
# VPS's own public IP if you don't have a domain. Used for TURN/coturn's
# realm and the address handed to WebRTC clients.
NODE_HOST=chat.example.com

# Leave empty for the no-domain / self-signed path. Set together with
# ACME_EMAIL to enable Caddy's automatic Let's Encrypt certificate.
DOMAIN=
ACME_EMAIL=you@example.com

POSTGRES_USER=stillhere
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=stillhere

# Must match POSTGRES_* above, host is the "postgres" service name.
DATABASE_URL=postgresql://stillhere:change-me-db-password@postgres:5432/stillhere?schema=public

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Shared secret coturn uses to validate TURN credentials it mints. Generate with: openssl rand -hex 32
TURN_SECRET=change-me-turn-secret

# Generate with: openssl rand -hex 32
NODE_TOKEN_SECRET=change-me-node-token-secret
NODE_TOKEN_TTL=365d
# The password clients must know to pair with this node (see POST /node/pair).
# Only read once, on first boot, to initialize the node — see
# server/src/modules/node/bootstrap.ts. Safe to leave set afterward.
NODE_SETUP_PASSWORD=change-me-node-password

CORS_ORIGIN=*
